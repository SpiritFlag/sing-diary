# Design Ref: docs/PDCA/2026-08/first-take/first-take.design.md §10.3
# 이 파일을 .env.local 로 복사하고 실제 값을 채운다
#   cp env.example .env.local
# .env.local은 .gitignore 대상이라 커밋되지 않는다

# Neon — pooled connection string (-pooler 호스트). WebSocket Pool 트랜잭션 전제 (Design §3.4, R1)
DATABASE_URL=

# 테스트 전용 Neon 브랜치 (Design §8: "실 Neon 브랜치 DB 대상"). DATABASE_URL과 반드시 다른
# 데이터베이스여야 한다 — npm test(vitest)가 매 실행마다 4개 테이블을 delete하고 재시딩한다.
# Neon 콘솔 → 프로젝트 → Branches → Create branch 로 만든 뒤 그 브랜치의 connection string.
TEST_DATABASE_URL=

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# 프로덕션(pk_live_*) + Vercel 커스텀 도메인 배포에서만 필요.
# 없으면 Clerk 7.x가 same-origin 자동 프록시(/__clerk)로 빠지는데 우리 앱엔
# 그 경로를 실제 Frontend API로 넘기는 처리가 없어 미들웨어가 404 루프에 빠진다.
# 값은 Clerk 대시보드에 등록한 Frontend API 커스텀 도메인(clerk.<도메인>).
NEXT_PUBLIC_CLERK_DOMAIN=

# pdcaw (사이클 종료 절차 전용, docs/RULE.md). PDCA-workspace 프로젝트의 Personal
# Access Token — 로컬 전용, Vercel에는 올리지 않는다.
PDCAW_PAT=

# scripts/run-l1.mjs 전용. L1_TARGET_URL이 Vercel Preview일 때만 필요 — Preview는
# 기본적으로 Vercel Deployment Protection이 걸려 있어 이 값 없이는 요청이 앱에
# 도달하기 전에 401 "Protected deployment"로 막힌다.
# 값: Vercel 대시보드 → 프로젝트 → Settings → Deployment Protection →
# Protection Bypass for Automation 에서 발급/복사.
# 로컬 전용 — Vercel에는 올리지 않는다 (그 값 자체가 Vercel의 보호를 우회하는 시크릿).
L1_VERCEL_BYPASS=
