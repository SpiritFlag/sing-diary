# Design Ref: docs/PDCA/2026-08/first-take/first-take.design.md §10.3
# 이 파일을 .env.local 로 복사하고 실제 값을 채운다
#   cp env.example .env.local
# .env.local은 .gitignore 대상이라 커밋되지 않는다

# Neon — pooled connection string (-pooler 호스트). WebSocket Pool 트랜잭션 전제 (Design §3.4, R1)
DATABASE_URL=

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
